{
    "name": "class-utilities",
    "version": "1.0.0",
    "description": "Class utility bot and management dashboard",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "build:web": "pnpm --prefix web run build",
        "build:all": "pnpm run build:web && pnpm run build",
        "start": "node dist/index.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:push": "prisma db push",
        "test:excel": "tsx scripts/test-excel-parser.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@fastify/cors": "^11.4.3",
        "@fastify/multipart": "^10.1.9",
        "@fastify/static": "^10.1.12",
        "@prisma/client": "^6.19.3",
        "@whiskeysockets/baileys": "^7.0.0-rc14",
        "dotenv": "^18.0.10",
        "fastify": "^5.12.8",
        "node-cron": "^4.6.0",
        "pino": "^10.4.0",
        "qrcode": "^1.5.4",
        "qrcode-terminal": "^0.12.0",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/node-cron": "^3.0.11",
        "@types/pino": "^7.0.4",
        "@types/qrcode": "^1.5.6",
        "@types/qrcode-terminal": "^0.12.2",
        "prettier": "^3.10.1",
        "prisma": "^6.19.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
