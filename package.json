{
    "name": "class-utilities",
    "version": "1.0.0",
    "description": "Class utility bot and management dashboard",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "dev:web": "astro dev",
        "build": "tsc",
        "build:web": "astro build",
        "build:all": "pnpm run build:web && pnpm run build",
        "start": "node dist/index.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:push": "prisma db push",
        "test:excel": "tsx scripts/test-excel-parser.ts",
        "test:ratelimit": "tsx scripts/test-rate-limiting.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "server:stop": "ssh awa@100.113.193.10 sudo systemctl stop class-utilities",
        "server:start": "ssh awa@100.113.193.10 sudo systemctl start class-utilities",
        "server:status": "ssh awa@100.113.193.10 sudo systemctl status class-utilities",
        "server:update": "ssh awa@100.113.193.10 /opt/class-utilities/deploy.sh",
        "server:push-db-to-prod": "echo '[WARN] Overwriting production database with local database...' && pnpm server:stop && scp data/class.db awa@100.113.193.10:/opt/class-utilities/data/class.db && pnpm server:start && echo '[OK] Local database pushed to production successfully.'"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@fastify/cors": "^11.4.3",
        "@fastify/multipart": "^10.1.9",
        "@fastify/static": "^10.1.12",
        "@hapi/boom": "^10.0.1",
        "@prisma/client": "^6.19.3",
        "@tailwindcss/vite": "^4.3.5",
        "@whiskeysockets/baileys": "^7.0.0-rc14",
        "astro": "^7.4.13",
        "dotenv": "^18.0.10",
        "fastify": "^5.12.8",
        "node-cron": "^4.6.0",
        "pino": "^10.4.0",
        "qrcode": "^1.5.4",
        "qrcode-terminal": "^0.12.0",
        "tailwindcss": "^4.3.5",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/node-cron": "^3.0.11",
        "@types/pino": "^7.0.4",
        "@types/qrcode": "^1.5.6",
        "@types/qrcode-terminal": "^0.12.2",
        "prettier": "^3.10.1",
        "prisma": "^6.19.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
